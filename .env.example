# TrustPilot AI Environment Variables Example
NODE_ENV=development
PORT=3000

# Authentication & JWT
JWT_SECRET=demo_jwt_secret_change_in_production_min_32_chars

# Database (PostgreSQL)
DATABASE_URL=postgresql://trustpilot_user:secure_password@localhost:5432/trustpilot_ai

# External Verification Providers (Optional - Leave blank for built-in modular mock providers)
OCR_PROVIDER_API_KEY=
LIVENESS_PROVIDER_API_KEY=
AML_PROVIDER_API_KEY=
STORAGE_BUCKET_URL=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

